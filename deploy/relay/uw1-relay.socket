# uw1's online play relay, started on demand: systemd listens here and starts
# uw1-relay.service on the first connection; nginx passes wss://ruzzoli.de/goplay/uw1relay
# to it (goplay's nginx/goplay.conf).
[Unit]
Description=uw1 online play relay (socket)

[Socket]
ListenStream=127.0.0.1:7781

[Install]
WantedBy=sockets.target
