[Unit]
Description=uw1 online play relay
Requires=uw1-relay.socket

[Service]
# stops 15 minutes after the last player left; the socket starts it again
ExecStart=/usr/local/bin/uw1relay -idle 15m
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M
